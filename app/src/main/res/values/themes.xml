<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme.MaterialComponents (bukan .Light) defaultnya sudah gelap,
         sehingga tema aplikasi selalu gelap terlepas dari setting sistem HP -->
    <style name="Theme.SehatAku" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/navy_light</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/grey_text</item>
    </style>
</resources>
